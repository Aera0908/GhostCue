# GhostCue Configuration Template
# Copy this file to '.env' and fill in your preferred provider credentials.

# LLM Provider: "gemini" | "openai" | "anthropic" | "deepseek" | "groq" | "ollama" | "custom"
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq
GROQ_API_KEY=

# Ollama (Local)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Custom OpenAI-Compatible (OpenRouter, Mistral, xAI, Bedrock, etc.)
CUSTOM_ENDPOINT=https://openrouter.ai/api/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=deepseek/deepseek-r1

# Smart Model Routing: routes complex coding/vision tasks to flagship models and conversational hints to fast models
SMART_MODEL_ROUTING=true

# Speech-to-Text: "local_whisper" | "deepgram"
STT_PROVIDER=local_whisper
DEEPGRAM_API_KEY=

# Auto-answer conversational pause threshold in milliseconds
AUTO_TRIGGER_DELAY_MS=1500

# Periodic Screen OCR
LIVE_OCR_ENABLED=false
LIVE_OCR_INTERVAL_SECS=10

# Candidate context and target role
TARGET_ROLE=
JOB_DESCRIPTION=
CANDIDATE_RESUME=
