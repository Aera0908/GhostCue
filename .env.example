# ==============================================================================
# GhostCue Stealth AI Interview Assistant - Environment Variables
# ==============================================================================
# Copy this file to '.env' and fill in your keys. GhostCue automatically loads 
# these values on startup so you never have to hardcode them.
# ==============================================================================

# --- LLM Providers ---
# Options: "ollama" | "openai" | "anthropic" | "groq"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq Configuration (Ultra-low latency inference)
GROQ_API_KEY=gsk_your-groq-key-here

# Local Ollama Configuration (Free, 100% offline)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Speech-to-Text (STT) ---
# Options: "local_whisper" | "deepgram"
STT_PROVIDER=local_whisper

# Deepgram Nova-2 API Key (Optional, for zero-CPU cloud STT)
DEEPGRAM_API_KEY=

# --- Interview Context & Candidate Persona ---
TARGET_ROLE="Senior Distributed Systems / Full Stack Engineer"
JOB_DESCRIPTION="Distributed systems, Rust, TypeScript, high-throughput message streams, and system architecture."
CANDIDATE_RESUME="Experienced senior engineer with 6+ years in backend services, high-concurrency microservices, and modern frontend frameworks."
